{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<footer role="contentinfo">
  {% if site.newsletter.enabled %}
    {% include newsletter.liquid %}
  {% endif %}
  <div class="container">
    <hr style="margin: 60px 0 30px 0; border: none; border-top: 1px solid #eee;">
    <div style="text-align:center; font-size:0.9rem; line-height:1.7; opacity:0.85;">
      MohammadHasan Sharifian<br>
      Department of Psychology, University of Michigan<br>
      East Hall, 530 Church Street, Ann Arbor, MI 48109<br>
      <a href="mailto:sharifih@umich.edu">sharifih@umich.edu</a>
    </div>
  </div>
</footer>
